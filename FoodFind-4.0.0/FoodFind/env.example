# Copie para .env e ajuste. O docker-compose lê este arquivo automaticamente.
PORT=3000
# Endereço público usado no link do QR Code (ex.: https://foodfind.meudominio.com.br).
# Sem ele, o servidor usa o endereço da própria requisição.
PUBLIC_URL=
# Conta administradora (aprova reivindicações e redefine senhas).
ADMIN_EMAIL=admin@foodfind.local
# Senha inicial do administrador: a conta é criada na primeira execução se ainda não existir.
# Troque a senha depois em "Minha conta".
ADMIN_PASSWORD=
# Pasta do banco e das fotos (no Docker, /app/data é um volume).
FOODFIND_DATA_DIR=
# Defina 1 somente se o FoodFind estiver atrás de um proxy reverso confiável (Nginx, Caddy, Render...).
TRUST_PROXY=0
# Opcional: PostgreSQL para guardar o banco e as fotos fora do disco do servidor
# (necessário em hospedagens gratuitas como o Render, que apagam o disco ao reiniciar).
# Ex.: o endereço de conexão de um banco gratuito do Neon (postgresql://...?sslmode=require).
DATABASE_URL=
