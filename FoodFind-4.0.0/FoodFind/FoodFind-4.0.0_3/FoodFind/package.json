{
  "name": "foodfind",
  "version": "4.0.0",
  "description": "FoodFind: descubra restaurantes próximos, veja perfil, cardápio, fotos e avaliações e resgate descontos por QR Code.",
  "private": true,
  "license": "UNLICENSED",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "start:neon": "node --env-file=.env.local server.js",
    "dev": "node server.js --dev",
    "test": "node --test",
    "seed": "node scripts/seed.js",
    "seed:neon": "node --env-file=.env.local scripts/seed.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.2"
  },
  "engines": {
    "node": ">=20"
  }
}
